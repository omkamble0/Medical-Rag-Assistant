# Environment configuration for Medical-Rag-Assistant

# Server & API
PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# LLM Providers (Optional for live generation; fallback deterministic engine is included)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Vector Database (Qdrant / Chroma)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=clinical_evidence_v1

# Safety Guardrails
EMERGENCY_TRIAGE_ENABLED=true
MIN_CONFIDENCE_THRESHOLD=0.65
