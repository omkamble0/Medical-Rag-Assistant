# Environment configuration for Medical-Rag-Assistant

# Server & API
PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# LLM Providers (Optional for live generation; fallback deterministic engine is included)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Vector & Document Database (Qdrant Cloud Free Tier or Local Embedded)
# Free forever cluster at https://cloud.qdrant.io (1GB RAM, no credit card required)
QDRANT_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_cloud_api_key_here
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=medical_knowledge_collection

# Safety Guardrails
EMERGENCY_TRIAGE_ENABLED=true
MIN_CONFIDENCE_THRESHOLD=0.65
